<?xml version="1.0"?>
<robot name="ureca_two_robot_two_subgoal"
       xmlns:tesseract="http://tesseract-robotics.github.io/tesseract"
       tesseract:make_convex="true">
  <link name="base_link"/>

  <joint name="r1_joint_x" type="prismatic">
    <parent link="base_link"/><child link="r1_x_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-10.0" upper="10.0" effort="100" velocity="10"/>
  </joint>
  <link name="r1_x_link"/>
  <joint name="r1_joint_y" type="prismatic">
    <parent link="r1_x_link"/><child link="r1_y_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-10.0" upper="10.0" effort="100" velocity="10"/>
  </joint>
  <link name="r1_y_link"/>
  <joint name="r1_joint_z" type="prismatic">
    <parent link="r1_y_link"/><child link="r1_body"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="10"/>
  </joint>
  <link name="r1_body">
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
    <visual><geometry><sphere radius="0.10"/></geometry></visual>
  </link>

  <joint name="r2_joint_x" type="prismatic">
    <parent link="base_link"/><child link="r2_x_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-10.0" upper="10.0" effort="100" velocity="10"/>
  </joint>
  <link name="r2_x_link"/>
  <joint name="r2_joint_y" type="prismatic">
    <parent link="r2_x_link"/><child link="r2_y_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-10.0" upper="10.0" effort="100" velocity="10"/>
  </joint>
  <link name="r2_y_link"/>
  <joint name="r2_joint_z" type="prismatic">
    <parent link="r2_y_link"/><child link="r2_body"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="100" velocity="10"/>
  </joint>
  <link name="r2_body">
    <collision><geometry><sphere radius="0.10"/></geometry></collision>
    <visual><geometry><sphere radius="0.10"/></geometry></visual>
  </link>
</robot>
